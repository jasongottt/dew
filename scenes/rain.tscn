[gd_scene format=3]

[sub_resource type="Shader" id="Shader_rain"]
code = "shader_type canvas_item;

// rain falling over the level. it works in art pixels (2.5 game units each)
// so the drops line up with the tiles
uniform vec4 color : source_color = vec4(0.7, 0.75, 0.85, 0.5);
// game units a second
uniform float speed = 700.0;
// how far it leans as it falls, 0 is straight down
uniform float wind = 0.3;
// 0 to 1, how much of the sky has rain in it
uniform float amount = 0.12;
// in art pixels
uniform float drop_length = 6.0;
uniform float drop_gap = 90.0;
uniform float pixel = 2.5;
// the rect's size in game units, the level sets it
uniform vec2 size = vec2(1600.0, 900.0);

float rand(float n) {
	return fract(sin(n * 91.3458) * 47453.5453);
}

// 1 where a drop is, 0 everywhere else
float drops(vec2 p, float seed, float fall, float len) {
	float column = p.x - floor(p.y * wind);
	if (rand(column + seed) > amount) {
		return 0.0;
	}
	float offset = rand(column * 1.7 + seed) * drop_gap;
	float column_fall = fall * (0.8 + 0.4 * rand(column * 3.1 + seed));
	return step(mod(p.y - TIME * column_fall + offset, drop_gap), len);
}

void fragment() {
	vec2 p = floor(UV * size / pixel);
	float fall = speed / pixel;
	// close rain, and slower fainter rain further off
	float near = drops(p, 0.0, fall, drop_length);
	float far = drops(p, 50.0, fall * 0.6, drop_length * 0.5) * 0.5;
	COLOR = vec4(color.rgb, color.a * max(near, far));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_rain"]
resource_local_to_scene = true
shader = SubResource("Shader_rain")

[node name="Rain" type="ColorRect"]
z_index = 20
material = SubResource("ShaderMaterial_rain")
mouse_filter = 2
