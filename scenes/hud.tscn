[sub_resource type="Shader" id="Shader_fog"]
code = "shader_type canvas_item;

// dark everywhere except a circle around center (in 1600x900 game space)
uniform vec2 center = vec2(800.0, 450.0);
uniform float radius = 120.0;
uniform vec2 size = vec2(1600.0, 900.0);

void fragment() {
	float d = distance(UV * size, center);
	COLOR = vec4(0.0, 0.0, 0.0, smoothstep(radius - 30.0, radius, d) * 0.95);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fog"]
